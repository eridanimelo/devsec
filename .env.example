# Copie para .env e troque TODAS as senhas/chaves antes de usar.
#   cp .env.example .env
#
# Atenção: se você trocar as senhas de banco depois que os volumes já foram
# criados, será necessário recriar os volumes (make reset) ou as senhas não
# baterão com o banco já inicializado.

# ---------------------------------------------------------------- SonarQube
SONAR_PORT=9000
SONAR_DB_NAME=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=troque-esta-senha-sonar

# --------------------------------------------------------- Dependency-Track
# Interface web
DTRACK_WEB_PORT=9080
# API Server (usada também pelo navegador, por isso localhost e não "dtrack-apiserver")
DTRACK_API_PORT=9081
DTRACK_API_BASE_URL=http://localhost:9081
DTRACK_DB_NAME=dtrack
DTRACK_DB_USER=dtrack
DTRACK_DB_PASSWORD=troque-esta-senha-dtrack

# ------------------------------------------------------------------ OWASP ZAP
ZAP_PORT=9082
ZAP_API_KEY=troque-esta-api-key-zap
