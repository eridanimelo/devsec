# ============================================================================
# Perfil: Achernar Identity (backend Java/Spring + frontend Angular)
#
#   ./bin/devsec scan --profile profiles/achernar-identity.env
#   ./bin/devsec scan --profile profiles/achernar-identity.env --active --i-have-authorization
#
# Credenciais de teste ficam em profiles/achernar-identity.secrets.env:
#   AUTH_USERNAME=...
#   AUTH_PASSWORD=...
# ============================================================================

RUN_NAME=achernar-identity

# Relativos à raiz do devsec (ou absolutos).
BACKEND_PATH=../ACHERNAR/achernar_identity/backend
FRONTEND_PATH=../ACHERNAR/achernar_identity/frontend

APP_URL=http://localhost:4200
API_URL=http://localhost:8080
# A aplicação expõe OpenAPI? Se sim, aponte aqui:
# OPENAPI_SPEC=http://localhost:8080/v3/api-docs  (baixe para um arquivo antes)

# ------------------------------------------------------------------- auth
# A aplicação usa sessão em cookie + CSRF (Spring Security).
AUTH_MODE=login
AUTH_LOGIN_URL=http://localhost:4200/api/auth/login
AUTH_LOGIN_BODY='{"email":"__USERNAME__","password":"__PASSWORD__"}'
AUTH_CSRF_URL=http://localhost:4200/api/csrf
AUTH_USE_COOKIE=1
AUTH_COOKIE_NAME=IDENTITY_SESSION
AUTH_TOKEN_JSON_PATH=.accessToken
AUTH_REQUIRED=1

# ------------------------------------------------------------------ estágios
ENABLE_SAST=1
ENABLE_SCA=1
ENABLE_SECRETS=1
ENABLE_DAST=1
ENABLE_SONAR=1
ENABLE_DTRACK=1
ENABLE_GRYPE=1

SEMGREP_CONFIG=p/owasp-top-ten
SONAR_PROJECT_KEY=achernar-identity

# Pode subir a aplicação e suas dependências antes de analisar.
# O Compose utiliza o .env existente no diretório docker da aplicação.
APP_STACK_UP=1
APP_COMPOSE_FILE=../ACHERNAR/achernar_identity/docker/docker-compose.yml
APP_START_TIMEOUT=180

APP_COMPOSE_ENV_FILE=../ACHERNAR/achernar_identity/docker/.env

APP_HEALTH_URL=http://localhost:8080/api/health

AUTH_VERIFY_URL=http://localhost:4200/api/auth/session
