# ============================================================================
# Perfil de execução do devsec
#
# Copie este arquivo, ajuste os caminhos/URLs e rode:
#   ./bin/devsec scan --profile profiles/meu-projeto.env
#
# Credenciais NÃO devem ficar aqui. Crie ao lado:
#   profiles/meu-projeto.secrets.env   (gitignored)
# com AUTH_USERNAME / AUTH_PASSWORD / SONAR_TOKEN / DTRACK_API_KEY.
# ============================================================================

# ------------------------------------------------------------------ identidade
RUN_NAME=meu-projeto

# ------------------------------------------------------- código local (paths)
# Relativos à raiz deste repositório (devsec) ou absolutos.
BACKEND_PATH=
FRONTEND_PATH=

# --------------------------------------------------------------- alvo em execução
APP_URL=http://localhost:4200
API_URL=http://localhost:8080
# OpenAPI/Swagger opcional para scan de API:
# OPENAPI_SPEC=/caminho/openapi.json

# ------------------------------------------------------------------- DAST auth
# none | header | login | form | playwright
AUTH_MODE=none

# AUTH_MODE=header: header estático
# AUTH_HEADER=Authorization: Bearer eyJ...

# AUTH_MODE=login: faz POST e extrai token/cookie
# AUTH_LOGIN_URL=http://localhost:8080/api/auth/token
# AUTH_LOGIN_BODY='{"email":"__USERNAME__","password":"__PASSWORD__"}'
# AUTH_TOKEN_JSON_PATH=.accessToken
# AUTH_TOKEN_HEADER=Authorization
# AUTH_TOKEN_PREFIX=Bearer
# AUTH_USE_COOKIE=0
# AUTH_COOKIE_NAME=SESSION
# AUTH_CSRF_URL=http://localhost:8080/api/csrf
# AUTH_REQUIRED=1

# AUTH_MODE=form: login por formulário (experimental)
# AUTH_LOGIN_URL=http://localhost:8080/login
# AUTH_USER_FIELD=username
# AUTH_PASS_FIELD=password

# AUTH_MODE=playwright: script Node que devolve {"headers": {...}}
# AUTH_PLAYWRIGHT_SCRIPT=

# ------------------------------------------------------------- estágios e gate
ENABLE_SAST=1
ENABLE_SCA=1
ENABLE_SECRETS=1
ENABLE_DAST=1
ENABLE_SONAR=1
ENABLE_DTRACK=1
ENABLE_GRYPE=1
STACK_UP=1

# DAST ativo: exige --active --i-have-authorization na linha de comando.
ZAP_ACTIVE=0
# GATE_FAIL_ON=critical,high

# ------------------------------------------------------------------- ferramentas
# auto | p/owasp-top-ten | p/default | /caminho/para/regras
SEMGREP_CONFIG=p/owasp-top-ten
# SONAR_PROJECT_KEY=meu-projeto
# SONAR_TOKEN=
# DTRACK_API_KEY=
# PROJECT_VERSION=1.0.0

# ------------------------------------------------------------------- stack URLs
# SONAR_URL=http://localhost:9000
# DTRACK_URL=http://localhost:9081
# ZAP_URL=http://localhost:9082
