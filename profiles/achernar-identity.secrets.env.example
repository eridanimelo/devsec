# Credenciais de teste — NÃO versionar.
# Copie para profiles/achernar-identity.secrets.env e preencha.
AUTH_USERNAME=
AUTH_PASSWORD=

# Opcional: token fixo do SonarQube (evita gerar via admin/admin).
